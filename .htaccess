# Block direct access to .env files
<Files .env>
    Order allow,deny
    Deny from all
</Files>
<Files .env.local>
    Order allow,deny
    Deny from all
</Files>
<Files .env.production>
    Order allow,deny
    Deny from all
</Files>

# Disable directory listing
Options -Indexes

# Enforce HTTP to HTTPS redirection
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
